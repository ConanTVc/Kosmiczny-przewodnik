{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reborn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "races": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      }
    },
    "sourceCredit": {
      "type": "object",
      "properties": {
        "author": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "author"
      ],
      "additionalProperties": false
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "locId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "quests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "main",
                    "side",
                    "daily",
                    "repeatable"
                  ]
                },
                "aliases": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "races": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 7
                  }
                },
                "rebornMin": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "rebornMax": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                },
                "requires": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
                  }
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "requirements": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "rewards": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "note": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "requirements",
                      "rewards"
                    ],
                    "additionalProperties": false
                  }
                },
                "tips": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceCredit": {
                  "type": "object",
                  "properties": {
                    "author": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "author"
                  ],
                  "additionalProperties": false
                },
                "review": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "slug",
                "name",
                "kind",
                "steps"
              ],
              "additionalProperties": false
            }
          },
          "review": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "locId",
          "quests"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "reborn",
    "sourceCredit",
    "sections"
  ],
  "additionalProperties": false
}
