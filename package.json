{
  "name": "kosmiczny-przewodnik",
  "private": true,
  "type": "module",
  "description": "Solucje, poradniki i tracker zadań do gry Kosmiczni (kosmiczni.pl).",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:migrate": "pnpm --filter @kp/content migrate",
    "content:build": "pnpm --filter @kp/content build",
    "userscript": "pnpm --filter @kp/userscript build && pnpm --filter @kp/userscript preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
